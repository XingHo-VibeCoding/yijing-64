[{"id":1,"name":"乾","symbol":"䷀","pinyin":"qián","volume":"上经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"天","symbol":"乾"},"judgment":"元亨利贞。","image":"天行健，君子以自强不息。","fortune":"吉","fortuneBasis":["元亨利贞"],"lines":[{"position":1,"name":"初九","text":"潜龙勿用。"},{"position":2,"name":"九二","text":"见龙在田，利见大人。"},{"position":3,"name":"九三","text":"君子终日乾乾，夕惕若；厉，无咎。"},{"position":4,"name":"九四","text":"或跃在渊，无咎。"},{"position":5,"name":"九五","text":"飞龙在天，利见大人。"},{"position":6,"name":"上九","text":"亢龙有悔。"}]},{"id":2,"name":"坤","symbol":"䷁","pinyin":"kūn","volume":"上经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"地","symbol":"坤"},"judgment":"元亨，利牝马之贞。君子有攸往，先迷后得主。利西南得朋，东北丧朋。安贞吉。","image":"地势坤，君子以厚德载物。","fortune":"吉","fortuneBasis":["元亨","利牝马之贞","安贞吉"],"lines":[{"position":1,"name":"初六","text":"履霜，坚冰至。"},{"position":2,"name":"六二","text":"直方大，不习，无不利。"},{"position":3,"name":"六三","text":"含章可贞。或从王事，无成有终。"},{"position":4,"name":"六四","text":"括囊，无咎无誉。"},{"position":5,"name":"六五","text":"黄裳，元吉。"},{"position":6,"name":"上六","text":"龙战于野，其血玄黄。"}]},{"id":3,"name":"屯","symbol":"䷂","pinyin":"zhūn","volume":"上经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"雷","symbol":"震"},"judgment":"元亨利贞。勿用有攸往，利建侯。","image":"云雷屯，君子以经纶。","fortune":"平","fortuneBasis":["元亨利贞","勿用有攸往","利建侯"],"lines":[{"position":1,"name":"初九","text":"盘桓，利居贞，利建侯。"},{"position":2,"name":"六二","text":"屯如邅如，乘马班如。匪寇婚媾，女子贞不字，十年乃字。"},{"position":3,"name":"六三","text":"即鹿无虞，唯入于林中。君子几，不如舍。往吝。"},{"position":4,"name":"六四","text":"乘马班如，求婚媾，往吉，无不利。"},{"position":5,"name":"九五","text":"屯其膏，小贞吉，大贞凶。"},{"position":6,"name":"上六","text":"乘马班如，泣血涟如。"}]},{"id":4,"name":"蒙","symbol":"䷃","pinyin":"méng","volume":"上经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"水","symbol":"坎"},"judgment":"亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。","image":"山下出泉，蒙。君子以果行育德。","fortune":"吉","fortuneBasis":["亨","利贞"],"lines":[{"position":1,"name":"初六","text":"发蒙，利用刑人，用说桎梏。以往，吝。"},{"position":2,"name":"九二","text":"包蒙，吉。纳妇吉。子克家。"},{"position":3,"name":"六三","text":"勿用取女，见金夫，不有躬。无攸利。"},{"position":4,"name":"六四","text":"困蒙，吝。"},{"position":5,"name":"六五","text":"童蒙，吉。"},{"position":6,"name":"上九","text":"击蒙。不利为寇，利御寇。"}]},{"id":5,"name":"需","symbol":"䷄","pinyin":"xū","volume":"上经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"天","symbol":"乾"},"judgment":"有孚，光亨，贞吉。利涉大川。","image":"云上于天，需。君子以饮食宴乐。","fortune":"吉","fortuneBasis":["光亨","贞吉","利涉大川"],"lines":[{"position":1,"name":"初九","text":"需于郊，利用恒，无咎。"},{"position":2,"name":"九二","text":"需于沙，小有言，终吉。"},{"position":3,"name":"九三","text":"需于泥，致寇至。"},{"position":4,"name":"六四","text":"需于血，出自穴。"},{"position":5,"name":"九五","text":"需于酒食，贞吉。"},{"position":6,"name":"上六","text":"入于穴，有不速之客三人来，敬之终吉。"}]},{"id":6,"name":"讼","symbol":"䷅","pinyin":"sòng","volume":"上经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"水","symbol":"坎"},"judgment":"有孚，窒惕，中吉，终凶。利见大人，不利涉大川。","image":"天与水违行，讼。君子以做事谋始。","fortune":"凶","fortuneBasis":["中吉","终凶","不利涉大川"],"lines":[{"position":1,"name":"初六","text":"不永所事，小有言，终吉。"},{"position":2,"name":"九二","text":"不克讼，归而逋，其邑人三百户无眚。"},{"position":3,"name":"六三","text":"食旧德，贞厉，终吉。或从王事，无成。"},{"position":4,"name":"九四","text":"不克讼，复即命，渝安贞，吉。"},{"position":5,"name":"九五","text":"讼，元吉。"},{"position":6,"name":"上九","text":"或锡之鞶带，终朝三褫之。"}]},{"id":7,"name":"师","symbol":"䷆","pinyin":"shī","volume":"上经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"水","symbol":"坎"},"judgment":"贞，丈人吉，无咎。","image":"地中有水，师。君子以容民畜众。","fortune":"吉","fortuneBasis":["丈人吉","无咎"],"lines":[{"position":1,"name":"初六","text":"师出以律，否臧，凶。"},{"position":2,"name":"九二","text":"在师中，吉无咎，王三锡命。"},{"position":3,"name":"六三","text":"师或舆尸，凶。"},{"position":4,"name":"六四","text":"师左次，无咎。"},{"position":5,"name":"六五","text":"田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。"},{"position":6,"name":"上六","text":"大君有命，开国承家，小人勿用。"}]},{"id":8,"name":"比","symbol":"䷇","pinyin":"bǐ","volume":"上经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"地","symbol":"坤"},"judgment":"吉。原筮，元永贞，无咎。不宁方来，后夫凶。","image":"地上有水，比。先王以建万国，亲诸侯。","fortune":"吉","fortuneBasis":["吉","元永贞","无咎","后夫凶"],"lines":[{"position":1,"name":"初六","text":"有孚，比之，无咎。有孚盈缶，终来有它吉。"},{"position":2,"name":"六二","text":"比之自内，贞吉。"},{"position":3,"name":"六三","text":"比之匪人。"},{"position":4,"name":"六四","text":"外比之，贞吉。"},{"position":5,"name":"九五","text":"显比，王用三驱，失前禽。邑人不诫，吉。"},{"position":6,"name":"上六","text":"比之无首，凶。"}]},{"id":9,"name":"小畜","symbol":"䷈","pinyin":"xiǎo xù","volume":"上经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"天","symbol":"乾"},"judgment":"亨。密云不雨，自我西郊。","image":"风行天上，小畜。君子以懿文德。","fortune":"平","fortuneBasis":["亨","密云不雨"],"lines":[{"position":1,"name":"初九","text":"复自道，何其咎？吉。"},{"position":2,"name":"九二","text":"牵复，吉。"},{"position":3,"name":"九三","text":"舆说辐，夫妻反目。"},{"position":4,"name":"六四","text":"有孚，血去惕出，无咎。"},{"position":5,"name":"九五","text":"有孚挛如，富以其邻。"},{"position":6,"name":"上九","text":"既雨既处，尚德载。妇贞厉。月几望，君子征凶。"}]},{"id":10,"name":"履","symbol":"䷉","pinyin":"lǚ","volume":"上经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"泽","symbol":"兑"},"judgment":"履虎尾，不咥人，亨。","image":"上天下泽，履。君子以辨上下，定民志。","fortune":"平","fortuneBasis":["履虎尾","不咥人","亨"],"lines":[{"position":1,"name":"初九","text":"素履，往无咎。"},{"position":2,"name":"九二","text":"履道坦坦，幽人贞吉。"},{"position":3,"name":"六三","text":"眇能视，跛能履。履虎尾，咥人，凶。武人为于大君。"},{"position":4,"name":"九四","text":"履虎尾，愬愬，终吉。"},{"position":5,"name":"九五","text":"夬履，贞厉。"},{"position":6,"name":"上九","text":"视履考祥，其旋元吉。"}]},{"id":11,"name":"泰","symbol":"䷊","pinyin":"tài","volume":"上经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"天","symbol":"乾"},"judgment":"小往大来，吉亨。","image":"天地交，泰。后以财成天地之道，辅相天地之宜，以左右民。","fortune":"吉","fortuneBasis":["小往大来","吉亨"],"lines":[{"position":1,"name":"初九","text":"拔茅，茹以其汇，征吉。"},{"position":2,"name":"九二","text":"包荒，用冯河，不遐遗，朋亡，得尚于中行。"},{"position":3,"name":"九三","text":"无平不陂，无往不复。艰贞无咎。勿恤其孚，于食有福。"},{"position":4,"name":"六四","text":"翩翩不富以其邻，不戒以孚。"},{"position":5,"name":"六五","text":"帝乙归妹，以祉元吉。"},{"position":6,"name":"上六","text":"城复于隍，勿用师。自邑告命，贞吝。"}]},{"id":12,"name":"否","symbol":"䷋","pinyin":"pǐ","volume":"上经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"地","symbol":"坤"},"judgment":"否之匪人。不利君子贞。大往小来。","image":"天地不交，否。君子以俭德辟难，不可荣以禄。","fortune":"凶","fortuneBasis":["不利君子贞","大往小来"],"lines":[{"position":1,"name":"初六","text":"拔茅，茹以其汇，贞吉，亨。"},{"position":2,"name":"六二","text":"包承，小人吉；大人否，亨。"},{"position":3,"name":"六三","text":"包羞。"},{"position":4,"name":"九四","text":"有命无咎，畴离祉。"},{"position":5,"name":"九五","text":"休否，大人吉；其亡其亡，系于苞桑。"},{"position":6,"name":"上九","text":"倾否，先否后喜。"}]},{"id":13,"name":"同人","symbol":"䷌","pinyin":"tóng rén","volume":"上经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"火","symbol":"离"},"judgment":"同人于野，亨。利涉大川，利君子贞。","image":"天与火，同人。君子以类族辨物。","fortune":"吉","fortuneBasis":["同人于野","亨","利涉大川","利君子贞"],"lines":[{"position":1,"name":"初九","text":"同人于门，无咎。"},{"position":2,"name":"六二","text":"同人于宗，吝。"},{"position":3,"name":"九三","text":"伏戎于莽，升其高陵，三岁不兴。"},{"position":4,"name":"九四","text":"乘其墉，弗克攻，吉。"},{"position":5,"name":"九五","text":"同人，先号啕而后笑，大师克相遇。"},{"position":6,"name":"上九","text":"同人于郊，无悔。"}]},{"id":14,"name":"大有","symbol":"䷍","pinyin":"dà yǒu","volume":"上经","upper":{"name":"火","symbol":"离"},"lower":{"name":"天","symbol":"乾"},"judgment":"元亨。","image":"火在天上，大有。君子以遏恶扬善，顺天休命。","fortune":"吉","fortuneBasis":["元亨"],"lines":[{"position":1,"name":"初九","text":"无交害，匪咎；艰则无咎。"},{"position":2,"name":"九二","text":"大车以载，有攸往，无咎。"},{"position":3,"name":"九三","text":"公用，亨于天子，小人弗克。"},{"position":4,"name":"九四","text":"匪其彭，无咎。"},{"position":5,"name":"六五","text":"厥孚交如，威如，吉。"},{"position":6,"name":"上九","text":"自天祐之，吉无不利。"}]},{"id":15,"name":"谦","symbol":"䷎","pinyin":"qiān","volume":"上经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"山","symbol":"艮"},"judgment":"亨，君子有终。","image":"地中有山，谦。君子以裒多益寡，称物平施。","fortune":"吉","fortuneBasis":["亨","君子有终"],"lines":[{"position":1,"name":"初六","text":"谦谦君子，用涉大川，吉。"},{"position":2,"name":"六二","text":"鸣谦，贞吉。"},{"position":3,"name":"九三","text":"劳谦，君子有终，吉。"},{"position":4,"name":"六四","text":"无不利，㧑谦。"},{"position":5,"name":"六五","text":"不富以其邻，利用侵伐，无不利。"},{"position":6,"name":"上六","text":"鸣谦，利用行师，征邑国。"}]},{"id":16,"name":"豫","symbol":"䷏","pinyin":"yù","volume":"上经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"地","symbol":"坤"},"judgment":"利建侯行师。","image":"雷出地奋，豫。先王以作乐崇德，殷荐之上帝，以配祖考。","fortune":"吉","fortuneBasis":["利建侯行师"],"lines":[{"position":1,"name":"初六","text":"鸣豫，凶。"},{"position":2,"name":"六二","text":"介于石，不终日，贞吉。"},{"position":3,"name":"六三","text":"盱豫，悔。 迟有悔。"},{"position":4,"name":"九四","text":"由豫，大有得，勿疑，朋盍簪。"},{"position":5,"name":"六五","text":"贞疾，恒不死。"},{"position":6,"name":"上六","text":"冥豫，成有渝，无咎。"}]},{"id":17,"name":"随","symbol":"䷐","pinyin":"suí","volume":"上经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"雷","symbol":"震"},"judgment":"元亨，利贞，无咎。","image":"泽中有雷，随。君子以向晦入宴息。","fortune":"吉","fortuneBasis":["元亨","利贞","无咎"],"lines":[{"position":1,"name":"初九","text":"官有渝，贞吉。 出门交有功。"},{"position":2,"name":"六二","text":"系小子，失丈夫。"},{"position":3,"name":"六三","text":"系丈夫，失小子。随有求，得，利居贞。"},{"position":4,"name":"九四","text":"随有获，贞凶。有孚，在道以明，何咎？"},{"position":5,"name":"九五","text":"孚于嘉，吉。"},{"position":6,"name":"上六","text":"拘系之，乃从维之；王用亨于西山。"}]},{"id":18,"name":"蛊","symbol":"䷑","pinyin":"gǔ","volume":"上经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"风","symbol":"巽"},"judgment":"元亨，利涉大川。先甲三日，后甲三日。","image":"山下有风，蛊。君子以振民育德。","fortune":"吉","fortuneBasis":["元亨","利涉大川"],"lines":[{"position":1,"name":"初六","text":"干父之蛊，有子，考无咎。厉，终吉。"},{"position":2,"name":"九二","text":"干母之蛊，不可贞。"},{"position":3,"name":"九三","text":"干父之蛊，小有悔，无大咎。"},{"position":4,"name":"六四","text":"裕父之蛊，往见吝。"},{"position":5,"name":"六五","text":"干父之蛊，用誉。"},{"position":6,"name":"上九","text":"不事王侯，高尚其事。"}]},{"id":19,"name":"临","symbol":"䷒","pinyin":"lín","volume":"上经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"泽","symbol":"兑"},"judgment":"元亨利贞。至于八月有凶。","image":"泽上有地，临。君子以教思无穷，容保民无疆。","fortune":"吉","fortuneBasis":["元亨利贞","至于八月有凶"],"lines":[{"position":1,"name":"初九","text":"咸临，贞吉。"},{"position":2,"name":"九二","text":"咸临，吉，无不利。"},{"position":3,"name":"六三","text":"甘临，无攸利。即忧之，无咎。"},{"position":4,"name":"六四","text":"至临，无咎。"},{"position":5,"name":"六五","text":"知临，大君之宜，吉。"},{"position":6,"name":"上六","text":"敦临，吉，无咎。"}]},{"id":20,"name":"观","symbol":"䷓","pinyin":"guān","volume":"上经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"地","symbol":"坤"},"judgment":"盥而不荐，有孚颙若。","image":"风行地上，观。先王以省方观民设教。","fortune":"平","fortuneBasis":["盥而不荐","有孚颙若"],"lines":[{"position":1,"name":"初六","text":"童观，小人无咎，君子吝。"},{"position":2,"name":"六二","text":"窥观，利女贞。"},{"position":3,"name":"六三","text":"观我生，进退。"},{"position":4,"name":"六四","text":"观国之光，利用宾于王。"},{"position":5,"name":"九五","text":"观我生，君子无咎。"},{"position":6,"name":"上九","text":"观其生，君子无咎。"}]},{"id":21,"name":"噬嗑","symbol":"䷔","pinyin":"shì hé","volume":"上经","upper":{"name":"火","symbol":"离"},"lower":{"name":"雷","symbol":"震"},"judgment":"亨。利用狱。","image":"雷电噬嗑。先王以明罚敕法。","fortune":"吉","fortuneBasis":["亨","利用狱"],"lines":[{"position":1,"name":"初九","text":"屦校灭趾，无咎。"},{"position":2,"name":"六二","text":"噬肤灭鼻，无咎。"},{"position":3,"name":"六三","text":"噬腊肉，遇毒。小吝，无咎。"},{"position":4,"name":"九四","text":"噬干胏，得金矢。利艰贞，吉。"},{"position":5,"name":"六五","text":"噬干肉，得黄金。贞厉，无咎。"},{"position":6,"name":"上九","text":"何校灭耳，凶。"}]},{"id":22,"name":"贲","symbol":"䷕","pinyin":"bì","volume":"上经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"火","symbol":"离"},"judgment":"亨。小利有攸往。","image":"山下有火，贲。君子以明庶政，无敢折狱。","fortune":"吉","fortuneBasis":["亨","小利有攸往"],"lines":[{"position":1,"name":"初九","text":"贲其趾，舍车而徒。"},{"position":2,"name":"六二","text":"贲其须。"},{"position":3,"name":"九三","text":"贲如，濡如，永贞吉。"},{"position":4,"name":"六四","text":"贲如，皤如，白马翰如，匪寇婚媾。"},{"position":5,"name":"六五","text":"贲于丘园，束帛戋戋。吝，终吉。"},{"position":6,"name":"上九","text":"白贲，无咎。"}]},{"id":23,"name":"剥","symbol":"䷖","pinyin":"bō","volume":"上经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"地","symbol":"坤"},"judgment":"不利有攸往。","image":"山附于地，剥。上以厚下安宅。","fortune":"凶","fortuneBasis":["不利有攸往"],"lines":[{"position":1,"name":"初六","text":"剥床以足，蔑贞，凶。"},{"position":2,"name":"六二","text":"剥床以辨，蔑贞，凶。"},{"position":3,"name":"六三","text":"剥之，无咎。"},{"position":4,"name":"六四","text":"剥床以肤，凶。"},{"position":5,"name":"六五","text":"贯鱼，以宫人宠，无不利。"},{"position":6,"name":"上九","text":"硕果不食，君子得舆，小人剥庐。"}]},{"id":24,"name":"复","symbol":"䷗","pinyin":"fù","volume":"上经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"雷","symbol":"震"},"judgment":"亨。出入无疾，朋来无咎。反复其道，七日来复，利有攸往。","image":"雷在地中，复。先王以至日闭关，商旅不行，后不省方。","fortune":"吉","fortuneBasis":["亨","朋来无咎","利有攸往"],"lines":[{"position":1,"name":"初九","text":"不远复，无祇悔，元吉。"},{"position":2,"name":"六二","text":"休复，吉。"},{"position":3,"name":"六三","text":"频复，厉，无咎。"},{"position":4,"name":"六四","text":"中行独复。"},{"position":5,"name":"六五","text":"敦复，无悔。"},{"position":6,"name":"上六","text":"迷复，凶，有灾眚。用行师，终有大败，以其国君凶，至于十年不克征。"}]},{"id":25,"name":"无妄","symbol":"䷘","pinyin":"wú wàng","volume":"上经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"雷","symbol":"震"},"judgment":"元亨利贞。其匪正有眚，不利有攸往。","image":"天下雷行，物与无妄。先王以茂对时，育万物。","fortune":"吉","fortuneBasis":["元亨利贞","其匪正有眚","不利有攸往"],"lines":[{"position":1,"name":"初九","text":"无妄，往吉。"},{"position":2,"name":"六二","text":"不耕获，不菑畲，则利有攸往。"},{"position":3,"name":"六三","text":"无妄之灾。或系之牛，行人之得，邑人之灾。"},{"position":4,"name":"九四","text":"可贞，无咎。"},{"position":5,"name":"九五","text":"无妄之疾，勿药有喜。"},{"position":6,"name":"上九","text":"无妄，行有眚，无攸利。"}]},{"id":26,"name":"大畜","symbol":"䷙","pinyin":"dà xù","volume":"上经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"天","symbol":"乾"},"judgment":"利贞，不家食，吉。利涉大川。","image":"天在山中，大畜。君子以多识前言往行，以畜其德。","fortune":"吉","fortuneBasis":["利贞","不家食，吉","利涉大川"],"lines":[{"position":1,"name":"初九","text":"有厉，利已。"},{"position":2,"name":"九二","text":"舆说輹。"},{"position":3,"name":"九三","text":"良马逐，利艰贞。曰闲舆卫，利有攸往。"},{"position":4,"name":"六四","text":"童牛之牿，元吉。"},{"position":5,"name":"六五","text":"豮豕之牙，吉。"},{"position":6,"name":"上九","text":"何天之衢，亨。"}]},{"id":27,"name":"颐","symbol":"䷚","pinyin":"yí","volume":"上经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"雷","symbol":"震"},"judgment":"贞吉。观颐，自求口实。","image":"山下有雷，颐。君子以慎言语，节饮食。","fortune":"吉","fortuneBasis":["贞吉","自求口实"],"lines":[{"position":1,"name":"初九","text":"舍尔灵龟，观我朵颐，凶。"},{"position":2,"name":"六二","text":"颠颐，拂经；于丘颐，征凶。"},{"position":3,"name":"六三","text":"拂颐，贞凶。十年勿用，无攸利。"},{"position":4,"name":"六四","text":"颠颐，吉。虎视眈眈，其欲逐逐，无咎。"},{"position":5,"name":"六五","text":"拂经，居贞吉。不可涉大川。"},{"position":6,"name":"上九","text":"由颐，厉吉。利涉大川。"}]},{"id":28,"name":"大过","symbol":"䷛","pinyin":"dà guò","volume":"上经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"风","symbol":"巽"},"judgment":"栋桡。利有攸往，亨。","image":"泽灭木，大过。君子以独立不惧，遁世无闷。","fortune":"平","fortuneBasis":["栋桡","利有攸往","亨"],"lines":[{"position":1,"name":"初六","text":"藉用白茅，无咎。"},{"position":2,"name":"九二","text":"枯杨生稊，老夫得其女妻，无不利。"},{"position":3,"name":"九三","text":"栋桡，凶。"},{"position":4,"name":"九四","text":"栋隆，吉。有它吝。"},{"position":5,"name":"九五","text":"枯杨生花，老妇得其士夫，无咎无誉。"},{"position":6,"name":"上六","text":"过涉灭顶，凶，无咎。"}]},{"id":29,"name":"坎","symbol":"䷜","pinyin":"kǎn","volume":"上经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"水","symbol":"坎"},"judgment":"有孚，维心亨，行有尚。","image":"水洊至，习坎。君子以常德行，习教事。","fortune":"平","fortuneBasis":["有孚","维心亨","行有尚"],"lines":[{"position":1,"name":"初六","text":"习坎，入于坎窞。凶。"},{"position":2,"name":"九二","text":"坎有险，求小得。"},{"position":3,"name":"六三","text":"来之坎坎，险且枕，入于坎窞，勿用。"},{"position":4,"name":"六四","text":"樽酒簋贰，用缶，纳约自牖，终无咎。"},{"position":5,"name":"九五","text":"坎不盈，祗既平，无咎。"},{"position":6,"name":"上六","text":"系用征𬙊，寘于丛棘，三岁不得，凶。"}]},{"id":30,"name":"离","symbol":"䷝","pinyin":"lí","volume":"上经","upper":{"name":"火","symbol":"离"},"lower":{"name":"火","symbol":"离"},"judgment":"利贞，亨。畜牝牛，吉。","image":"明两作，离。大人以继明照四方。","fortune":"吉","fortuneBasis":["利贞","亨","畜牝牛，吉"],"lines":[{"position":1,"name":"初九","text":"履错然，敬之，无咎。"},{"position":2,"name":"六二","text":"黄离，元吉。"},{"position":3,"name":"九三","text":"日昃之离。不鼓缶而歌，则大耋之嗟，凶。"},{"position":4,"name":"九四","text":"突如其来如，焚如，死如，弃如。"},{"position":5,"name":"六五","text":"出涕沱若，戚嗟若，吉。"},{"position":6,"name":"上九","text":"王用出征，有嘉。折首，获匪其丑，无咎。"}]},{"id":31,"name":"咸","symbol":"䷞","pinyin":"xián","volume":"下经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"山","symbol":"艮"},"judgment":"亨，利贞。取女吉。","image":"山上有泽，咸。君子以虚受人。","fortune":"吉","fortuneBasis":["亨","利贞","取女吉"],"lines":[{"position":1,"name":"初六","text":"咸其拇。"},{"position":2,"name":"六二","text":"咸其腓，凶，居吉。"},{"position":3,"name":"九三","text":"咸其股，执其随，往吝。"},{"position":4,"name":"九四","text":"贞吉悔亡，憧憧往来，朋从尔思。"},{"position":5,"name":"九五","text":"咸其脢，无悔。"},{"position":6,"name":"上六","text":"咸其辅、颊、舌。"}]},{"id":32,"name":"恒","symbol":"䷟","pinyin":"héng","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"风","symbol":"巽"},"judgment":"亨，无咎，利贞。利有攸往。","image":"雷风恒。君子以立不易方。","fortune":"吉","fortuneBasis":["亨","无咎","利贞","利有攸往"],"lines":[{"position":1,"name":"初六","text":"浚恒，贞凶，无攸利。"},{"position":2,"name":"九二","text":"悔亡。"},{"position":3,"name":"九三","text":"不恒其德，或承之羞，贞吝。"},{"position":4,"name":"九四","text":"田无禽。"},{"position":5,"name":"六五","text":"恒其德，贞。妇人吉，夫子凶。"},{"position":6,"name":"上六","text":"振恒，凶。"}]},{"id":33,"name":"遁","symbol":"䷠","pinyin":"dùn","volume":"下经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"山","symbol":"艮"},"judgment":"亨。小利贞。","image":"天下有山，遁。君子以远小人，不恶而严。","fortune":"平","fortuneBasis":["亨","小利贞"],"lines":[{"position":1,"name":"初六","text":"遁尾，厉。勿用有攸往。"},{"position":2,"name":"六二","text":"执之用黄牛之革，莫之胜说。"},{"position":3,"name":"九三","text":"系遁，有疾厉。畜臣妾，吉。"},{"position":4,"name":"九四","text":"好遁，君子吉，小人否。"},{"position":5,"name":"九五","text":"嘉遁，贞吉。"},{"position":6,"name":"上九","text":"肥遁，无不利。"}]},{"id":34,"name":"大壮","symbol":"䷡","pinyin":"dà zhuàng","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"天","symbol":"乾"},"judgment":"利贞。","image":"雷在天上，大壮。君子以非礼弗履。","fortune":"吉","fortuneBasis":["利贞"],"lines":[{"position":1,"name":"初九","text":"壮于趾，征凶，有孚。"},{"position":2,"name":"九二","text":"贞吉。"},{"position":3,"name":"九三","text":"小人用壮，君子用罔；贞厉，羝羊触藩，羸其角。"},{"position":4,"name":"九四","text":"贞吉，悔亡；藩决不羸，壮于大舆之輹。"},{"position":5,"name":"六五","text":"丧羊于易，无悔。"},{"position":6,"name":"上六","text":"羝羊触藩，不能退，不能遂，无攸利。艰则吉。"}]},{"id":35,"name":"晋","symbol":"䷢","pinyin":"jìn","volume":"下经","upper":{"name":"火","symbol":"离"},"lower":{"name":"地","symbol":"坤"},"judgment":"康侯用锡马蕃庶，昼日三接。","image":"明出地上，晋。君子以自昭明德。","fortune":"平","fortuneBasis":["康侯用锡马蕃庶","昼日三接"],"lines":[{"position":1,"name":"初六","text":"晋如，摧如，贞吉。罔孚，裕，无咎。"},{"position":2,"name":"六二","text":"晋如，愁如，贞吉。受兹介福，于其王母。"},{"position":3,"name":"六三","text":"众允，悔亡。"},{"position":4,"name":"九四","text":"晋如鼫鼠，贞厉。"},{"position":5,"name":"六五","text":"悔亡，失得勿恤，往吉，无不利。"},{"position":6,"name":"上九","text":"晋其角，维用伐邑，厉吉无咎，贞吝。"}]},{"id":36,"name":"明夷","symbol":"䷣","pinyin":"míng yí","volume":"下经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"火","symbol":"离"},"judgment":"利艰贞。","image":"明入地中，明夷。君子以莅众用晦而明。","fortune":"凶","fortuneBasis":["利艰贞"],"lines":[{"position":1,"name":"初九","text":"明夷于飞，垂其翼。君子于行，三日不食。有攸往，主人有言。"},{"position":2,"name":"六二","text":"明夷，夷于左股，用拯马壮，吉。"},{"position":3,"name":"九三","text":"明夷于南狩，得其大首，不可疾，贞。"},{"position":4,"name":"六四","text":"入于左腹，获明夷之心，于出门庭。"},{"position":5,"name":"六五","text":"箕子之明夷，利贞。"},{"position":6,"name":"上六","text":"不明，晦。初登于天，后入于地。"}]},{"id":37,"name":"家人","symbol":"䷤","pinyin":"jiā rén","volume":"下经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"火","symbol":"离"},"judgment":"利女贞。","image":"风自火出，家人。君子以言有物而行有恒。","fortune":"吉","fortuneBasis":["利女贞"],"lines":[{"position":1,"name":"初九","text":"闲有家，悔亡。"},{"position":2,"name":"六二","text":"无攸遂，在中馈，贞吉。"},{"position":3,"name":"九三","text":"家人嗃嗃，悔厉，吉；妇子嘻嘻，终吝。"},{"position":4,"name":"六四","text":"富家，大吉。"},{"position":5,"name":"九五","text":"王假有家，勿恤，吉。"},{"position":6,"name":"上九","text":"有孚威如，终吉。"}]},{"id":38,"name":"睽","symbol":"䷥","pinyin":"kuí","volume":"下经","upper":{"name":"火","symbol":"离"},"lower":{"name":"泽","symbol":"兑"},"judgment":"小事吉。","image":"上火下泽，睽。君子以同而异。","fortune":"平","fortuneBasis":["小事吉"],"lines":[{"position":1,"name":"初九","text":"悔亡，丧马勿逐，自复。见恶人，无咎。"},{"position":2,"name":"九二","text":"遇主于巷，无咎。"},{"position":3,"name":"六三","text":"见舆曳，其牛掣。其人天且劓，无初有终。"},{"position":4,"name":"九四","text":"睽孤，遇元夫。交孚，厉无咎。"},{"position":5,"name":"六五","text":"悔亡，厥宗噬肤，往何咎？"},{"position":6,"name":"上九","text":"睽孤，见豕负涂，载鬼一车。先张之弧，后说之弧，匪寇婚媾。往遇雨则吉。"}]},{"id":39,"name":"蹇","symbol":"䷦","pinyin":"jiǎn","volume":"下经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"山","symbol":"艮"},"judgment":"利西南，不利东北。利见大人，贞吉。","image":"山上有水，蹇。君子以反身修德。","fortune":"凶","fortuneBasis":["利西南","不利东北","利见大人","贞吉"],"lines":[{"position":1,"name":"初六","text":"往蹇来誉。"},{"position":2,"name":"六二","text":"王臣蹇蹇，匪躬之故。"},{"position":3,"name":"九三","text":"往蹇来反。"},{"position":4,"name":"六四","text":"往蹇来连。"},{"position":5,"name":"九五","text":"大蹇，朋来。"},{"position":6,"name":"上六","text":"往蹇来硕，吉。利见大人。"}]},{"id":40,"name":"解","symbol":"䷧","pinyin":"xiè","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"水","symbol":"坎"},"judgment":"利西南。无所往，其来复吉。有攸往，夙吉。","image":"雷雨作，解。君子以赦过宥罪。","fortune":"吉","fortuneBasis":["利西南","其来复吉","有攸往，夙吉"],"lines":[{"position":1,"name":"初六","text":"无咎。"},{"position":2,"name":"九二","text":"田获三狐，得黄矢，贞吉。"},{"position":3,"name":"六三","text":"负且乘，致寇至，贞吝。"},{"position":4,"name":"九四","text":"解而拇，朋至斯孚。"},{"position":5,"name":"六五","text":"君子维有解，吉，有孚于小人。"},{"position":6,"name":"上六","text":"公用射隼于高墉之上，获之无不利。"}]},{"id":41,"name":"损","symbol":"䷨","pinyin":"sǔn","volume":"下经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"泽","symbol":"兑"},"judgment":"有孚，元吉，无咎，可贞。利有攸往。曷之用？二簋可用享。","image":"山下有泽，损。君子以征忿窒欲。","fortune":"吉","fortuneBasis":["元吉","无咎","可贞","利有攸往"],"lines":[{"position":1,"name":"初九","text":"已事遄往，无咎，酌损之。"},{"position":2,"name":"九二","text":"利贞，征凶。弗损，益之。"},{"position":3,"name":"六三","text":"三人行则损一人；一人行则得其友。"},{"position":4,"name":"六四","text":"损其疾，使遄有喜，无咎。"},{"position":5,"name":"六五","text":"或益之十朋之龟，弗克违。元吉。"},{"position":6,"name":"上九","text":"弗损，益之，无咎。贞吉。 利有攸往，得臣无家。"}]},{"id":42,"name":"益","symbol":"䷩","pinyin":"yì","volume":"下经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"雷","symbol":"震"},"judgment":"利有攸往，利涉大川。","image":"风雷，益。君子以见善则迁，有过则改。","fortune":"吉","fortuneBasis":["利有攸往","利涉大川"],"lines":[{"position":1,"name":"初九","text":"利用为大作，元吉，无咎。"},{"position":2,"name":"六二","text":"或益之十朋之龟，弗克违，永贞吉。王用享于帝，吉。"},{"position":3,"name":"六三","text":"益之用凶事，无咎。有孚中行，告公用圭。"},{"position":4,"name":"六四","text":"中行，告公从。利用为依迁国。"},{"position":5,"name":"九五","text":"有孚惠心，勿问元吉。有孚惠我德。"},{"position":6,"name":"上九","text":"莫益之，或击之，立心勿恒，凶。"}]},{"id":43,"name":"夬","symbol":"䷪","pinyin":"guài","volume":"下经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"天","symbol":"乾"},"judgment":"扬于王庭，孚号有厉。告自邑，不利即戎，利有攸往。","image":"泽上于天，夬。君子以施禄及下，居德则忌。","fortune":"凶","fortuneBasis":["孚号有厉","不利即戎","利有攸往"],"lines":[{"position":1,"name":"初九","text":"壮于前趾，往不胜为咎。"},{"position":2,"name":"九二","text":"惕号，莫夜有戎，勿恤。"},{"position":3,"name":"九三","text":"壮于頄，有凶。君子夬夬独行，遇雨若濡，有愠，无咎。"},{"position":4,"name":"九四","text":"臀无肤，其行次且。牵羊悔亡，闻言不信。"},{"position":5,"name":"九五","text":"苋陆夬夬，中行无咎。"},{"position":6,"name":"上六","text":"无号，终有凶。"}]},{"id":44,"name":"姤","symbol":"䷫","pinyin":"gòu","volume":"下经","upper":{"name":"天","symbol":"乾"},"lower":{"name":"风","symbol":"巽"},"judgment":"女壮，勿用取女。","image":"天下有风，姤。后以施命诰四方。","fortune":"凶","fortuneBasis":["女壮","勿用取女"],"lines":[{"position":1,"name":"初六","text":"系于金柅，贞吉。有攸往，见凶。羸豕孚蹢躅。"},{"position":2,"name":"九二","text":"包有鱼，无咎，不利宾。"},{"position":3,"name":"九三","text":"臀无肤，其行次且。厉，无大咎。"},{"position":4,"name":"九四","text":"包无鱼，起凶。"},{"position":5,"name":"九五","text":"以杞包瓜，含章，有陨自天。"},{"position":6,"name":"上九","text":"姤其角，吝，无咎。"}]},{"id":45,"name":"萃","symbol":"䷬","pinyin":"cuì","volume":"下经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"地","symbol":"坤"},"judgment":"亨，王假有庙。利见大人，亨，利贞。用大牲吉。利有攸往。","image":"泽上于地，萃。君子以除戎器，戒不虞。","fortune":"吉","fortuneBasis":["亨","利见大人","利贞","用大牲吉","利有攸往"],"lines":[{"position":1,"name":"初六","text":"有孚不终，乃乱乃萃。若号，一握为笑。勿恤，往无咎"},{"position":2,"name":"六二","text":"引吉，无咎。孚乃利用禴。"},{"position":3,"name":"六三","text":"萃如，嗟如，无攸利。往无咎，小吝。"},{"position":4,"name":"九四","text":"大吉，无咎。"},{"position":5,"name":"九五","text":"萃有位，无咎。匪孚，元永贞，悔亡。"},{"position":6,"name":"上六","text":"赍咨涕洟，无咎。"}]},{"id":46,"name":"升","symbol":"䷭","pinyin":"shēng","volume":"下经","upper":{"name":"地","symbol":"坤"},"lower":{"name":"风","symbol":"巽"},"judgment":"元亨。用见大人，勿恤，南征吉。","image":"地中生木，升。君子以顺德，积小以高大。","fortune":"吉","fortuneBasis":["元亨","用见大人","南征吉"],"lines":[{"position":1,"name":"初六","text":"允升，大吉。"},{"position":2,"name":"九二","text":"孚乃利用禴，无咎。"},{"position":3,"name":"九三","text":"升虚邑。"},{"position":4,"name":"六四","text":"王用亨于岐山，吉，无咎。"},{"position":5,"name":"六五","text":"贞吉，升阶。"},{"position":6,"name":"上六","text":"冥升，利于不息之贞。"}]},{"id":47,"name":"困","symbol":"䷮","pinyin":"kùn","volume":"下经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"水","symbol":"坎"},"judgment":"亨，贞，大人吉，无咎。有言不信。","image":"泽无水，困。君子以致命遂志。","fortune":"凶","fortuneBasis":["卦义为困穷","有言不信"],"lines":[{"position":1,"name":"初六","text":"臀困于株木，入于幽谷，三岁不觌。"},{"position":2,"name":"九二","text":"困于洒食，朱绂方来，利用享祀。征凶，无咎。"},{"position":3,"name":"六三","text":"困于石，据于疾藜。入于其宫，不见其妻，凶。"},{"position":4,"name":"九四","text":"来徐徐，困于金车，吝，有终。"},{"position":5,"name":"九五","text":"劓刖，困于赤绂。乃徐，有说，利用祭祀。"},{"position":6,"name":"上六","text":"困于葛藟，于臲卼，曰动悔。有悔，征吉。"}]},{"id":48,"name":"井","symbol":"䷯","pinyin":"jǐng","volume":"下经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"风","symbol":"巽"},"judgment":"改邑不改井，无丧无得。往来井井。汔至亦未繘井，羸其瓶，凶。","image":"木上有水，井。君子以劳民劝相。","fortune":"平","fortuneBasis":["无丧无得","往来井井","羸其瓶，凶"],"lines":[{"position":1,"name":"初六","text":"井泥不食，旧井无禽。"},{"position":2,"name":"九二","text":"井谷射鲋，瓮敝漏。"},{"position":3,"name":"九三","text":"井渫不食，为我心恻。可用汲，王明，并受其福。"},{"position":4,"name":"六四","text":"井甃，无咎。"},{"position":5,"name":"九五","text":"井冽寒泉，食。"},{"position":6,"name":"上六","text":"井收勿幕，有孚元吉。"}]},{"id":49,"name":"革","symbol":"䷰","pinyin":"gé","volume":"下经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"火","symbol":"离"},"judgment":"己日乃孚。元亨利贞。悔亡。","image":"泽中有火，革。君子以治历明时。","fortune":"吉","fortuneBasis":["元亨利贞","悔亡"],"lines":[{"position":1,"name":"初九","text":"巩用黄牛之革。"},{"position":2,"name":"六二","text":"己日乃革之。征吉，无咎。"},{"position":3,"name":"九三","text":"征凶贞厉。革言三就，有孚。"},{"position":4,"name":"九四","text":"悔亡，有孚，改命，吉。"},{"position":5,"name":"九五","text":"大人虎变，未占有孚。"},{"position":6,"name":"上六","text":"君子豹变，小人革面。征凶，居贞吉。"}]},{"id":50,"name":"鼎","symbol":"䷱","pinyin":"dǐng","volume":"下经","upper":{"name":"火","symbol":"离"},"lower":{"name":"风","symbol":"巽"},"judgment":"元吉，亨。","image":"木上有火，鼎。君子以正位凝命。","fortune":"吉","fortuneBasis":["元吉","亨"],"lines":[{"position":1,"name":"初六","text":"鼎颠趾，利出否。得妾以其子，无咎。"},{"position":2,"name":"九二","text":"鼎有实，我仇有疾，不我能即，吉。"},{"position":3,"name":"九三","text":"鼎耳革，其行塞，雉膏不食。方雨，亏悔，终吉。"},{"position":4,"name":"九四","text":"鼎折足，覆公𫗧，其形渥，凶。"},{"position":5,"name":"六五","text":"鼎黄耳金铉，利贞。"},{"position":6,"name":"上九","text":"鼎玉铉，大吉，无不利。"}]},{"id":51,"name":"震","symbol":"䷲","pinyin":"zhèn","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"雷","symbol":"震"},"judgment":"亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。","image":"洊雷，震。君子以恐惧修省。","fortune":"平","fortuneBasis":["亨","震来虩虩"],"lines":[{"position":1,"name":"初九","text":"震来虩虩，后笑言哑哑，吉。"},{"position":2,"name":"六二","text":"震来厉，亿丧贝。跻于九陵，勿逐，七日得。"},{"position":3,"name":"六三","text":"震苏苏，震行无眚。"},{"position":4,"name":"九四","text":"震遂泥。"},{"position":5,"name":"六五","text":"震往来厉，亿无丧，有事。"},{"position":6,"name":"上六","text":"震索索，视矍矍，征凶。震不于其躬，于其邻，无咎。婚媾有言。"}]},{"id":52,"name":"艮","symbol":"䷳","pinyin":"gèn","volume":"下经","upper":{"name":"山","symbol":"艮"},"lower":{"name":"山","symbol":"艮"},"judgment":"艮其背，不获其身。行其庭，不见其人。无咎。","image":"兼山，艮。君子以思不出其位。","fortune":"平","fortuneBasis":["艮其背","无咎"],"lines":[{"position":1,"name":"初六","text":"艮其趾，无咎。利永贞。"},{"position":2,"name":"六二","text":"艮其腓，不拯其随，其心不快。"},{"position":3,"name":"九三","text":"艮其限，列其夤，厉薰心。"},{"position":4,"name":"六四","text":"艮其身，无咎。"},{"position":5,"name":"六五","text":"艮其辅，言有序，悔亡。"},{"position":6,"name":"上九","text":"敦艮，吉。"}]},{"id":53,"name":"渐","symbol":"䷴","pinyin":"jiàn","volume":"下经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"山","symbol":"艮"},"judgment":"女归吉，利贞。","image":"山上有木，渐。君子以居贤德善俗。","fortune":"吉","fortuneBasis":["女归吉","利贞"],"lines":[{"position":1,"name":"初六","text":"鸿渐于干，小子厉。有言，无咎。"},{"position":2,"name":"六二","text":"鸿渐于磐，饮食衎衎，吉。"},{"position":3,"name":"九三","text":"鸿渐于陆，夫征不复，妇孕不育，凶。利御寇。"},{"position":4,"name":"六四","text":"鸿渐于木，或得其桷，无咎。"},{"position":5,"name":"九五","text":"鸿渐于陵，妇三岁不孕，终莫之胜，吉。"},{"position":6,"name":"上九","text":"鸿渐于陆，其羽可用为仪，吉。"}]},{"id":54,"name":"归妹","symbol":"䷵","pinyin":"guī mèi","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"泽","symbol":"兑"},"judgment":"征凶，无攸利。","image":"泽上有雷，归妹。君子以永终知敝。","fortune":"凶","fortuneBasis":["征凶","无攸利"],"lines":[{"position":1,"name":"初九","text":"归妹以娣，跛能履，征吉。"},{"position":2,"name":"九二","text":"眇能视，利幽人之贞。"},{"position":3,"name":"六三","text":"归妹以须，反归以娣。"},{"position":4,"name":"九四","text":"归妹愆期，迟归有时。"},{"position":5,"name":"六五","text":"帝乙归妹，其君之袂不如其娣之袂良。月几望，吉。"},{"position":6,"name":"上六","text":"女承筐无实，士刲羊无血，无攸利。"}]},{"id":55,"name":"丰","symbol":"䷶","pinyin":"fēng","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"火","symbol":"离"},"judgment":"亨。王假之，勿忧，宜日中。","image":"雷电皆至，丰。君子以折狱致刑。","fortune":"吉","fortuneBasis":["亨","勿忧","宜日中"],"lines":[{"position":1,"name":"初九","text":"遇其配主，虽旬无咎；往有尚。"},{"position":2,"name":"六二","text":"丰其蔀，日中见斗。往得疑疾。有孚发若，吉。"},{"position":3,"name":"九三","text":"丰其沛，日中见沬。折其右肱，无咎。"},{"position":4,"name":"九四","text":"丰其蔀，日中见斗。遇其夷主，吉。"},{"position":5,"name":"六五","text":"来章，有庆誉，吉。"},{"position":6,"name":"上六","text":"丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。"}]},{"id":56,"name":"旅","symbol":"䷷","pinyin":"lǚ","volume":"下经","upper":{"name":"火","symbol":"离"},"lower":{"name":"山","symbol":"艮"},"judgment":"小亨，旅贞吉。","image":"山上有火，旅。君子以明慎用刑而不留狱。","fortune":"平","fortuneBasis":["小亨","旅贞吉"],"lines":[{"position":1,"name":"初六","text":"旅琐琐，斯其所取灾。"},{"position":2,"name":"六二","text":"旅即次，怀其资，得童仆，贞。"},{"position":3,"name":"九三","text":"旅焚其次，丧其童仆，贞厉。"},{"position":4,"name":"九四","text":"旅于处，得其资斧，我心不快。"},{"position":5,"name":"六五","text":"射雉，一矢亡，终以誉命。"},{"position":6,"name":"上九","text":"鸟焚其巢，旅人先笑后号啕。丧牛于易，凶。"}]},{"id":57,"name":"巽","symbol":"䷸","pinyin":"xùn","volume":"下经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"风","symbol":"巽"},"judgment":"小亨。利有攸往，利见大人。","image":"随风，巽。君子以申命行事。","fortune":"吉","fortuneBasis":["小亨","利有攸往","利见大人"],"lines":[{"position":1,"name":"初六","text":"进退，利武人之贞。"},{"position":2,"name":"九二","text":"巽在床下，用史巫纷若，吉，无咎。"},{"position":3,"name":"九三","text":"频巽，吝。"},{"position":4,"name":"六四","text":"悔亡，田获三品。"},{"position":5,"name":"九五","text":"贞吉，悔亡，无不利。无初有终。先庚三日，后庚三日，吉。"},{"position":6,"name":"上九","text":"巽在床下，丧其资斧，贞凶。"}]},{"id":58,"name":"兑","symbol":"䷹","pinyin":"duì","volume":"下经","upper":{"name":"泽","symbol":"兑"},"lower":{"name":"泽","symbol":"兑"},"judgment":"亨，利，贞。","image":"丽泽兑。君子以朋友讲习。","fortune":"吉","fortuneBasis":["亨","利","贞"],"lines":[{"position":1,"name":"初九","text":"和兑，吉。"},{"position":2,"name":"九二","text":"孚兑，吉，悔亡。"},{"position":3,"name":"六三","text":"来兑，凶。"},{"position":4,"name":"九四","text":"商兑未宁，介疾有喜。"},{"position":5,"name":"九五","text":"孚于剥，有厉。"},{"position":6,"name":"上六","text":"引兑。"}]},{"id":59,"name":"涣","symbol":"䷺","pinyin":"huàn","volume":"下经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"水","symbol":"坎"},"judgment":"亨，王假有庙。利涉大川，利贞。","image":"风行水上，涣。先王以享于帝，立庙。","fortune":"吉","fortuneBasis":["亨","利涉大川","利贞"],"lines":[{"position":1,"name":"初六","text":"用拯马壮，吉。"},{"position":2,"name":"九二","text":"涣奔其机，悔亡。"},{"position":3,"name":"六三","text":"涣其躬，无悔。"},{"position":4,"name":"六四","text":"涣其群，元吉。涣有丘，匪夷所思。"},{"position":5,"name":"九五","text":"涣汗，其大号涣，王居，无咎。"},{"position":6,"name":"上九","text":"涣其血，去逖出，无咎。"}]},{"id":60,"name":"节","symbol":"䷻","pinyin":"jié","volume":"下经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"泽","symbol":"兑"},"judgment":"亨，苦节不可贞。","image":"泽上有水，节。君子以制数度，议德行。","fortune":"平","fortuneBasis":["亨","苦节不可贞"],"lines":[{"position":1,"name":"初九","text":"不出户庭，无咎。"},{"position":2,"name":"九二","text":"不出门庭，凶。"},{"position":3,"name":"六三","text":"不节若，则嗟若。无咎。"},{"position":4,"name":"六四","text":"安节，亨。"},{"position":5,"name":"九五","text":"甘节，吉，往有尚。"},{"position":6,"name":"上六","text":"苦节，贞凶。悔亡。"}]},{"id":61,"name":"中孚","symbol":"䷼","pinyin":"zhōng fú","volume":"下经","upper":{"name":"风","symbol":"巽"},"lower":{"name":"泽","symbol":"兑"},"judgment":"豚鱼，吉。利涉大川，利贞。","image":"泽上有风，中孚。君子以议狱缓死。","fortune":"吉","fortuneBasis":["豚鱼，吉","利涉大川","利贞"],"lines":[{"position":1,"name":"初九","text":"虞吉，有它不燕。"},{"position":2,"name":"九二","text":"鸣鹤在阴，其子和之。我有好爵，吾与尔靡之。"},{"position":3,"name":"六三","text":"得敌，或鼓或罢，或泣或歌。"},{"position":4,"name":"六四","text":"月既望，马匹亡，无咎。"},{"position":5,"name":"九五","text":"有孚挛如，无咎。"},{"position":6,"name":"上九","text":"翰音登于天，贞凶。"}]},{"id":62,"name":"小过","symbol":"䷽","pinyin":"xiǎo guò","volume":"下经","upper":{"name":"雷","symbol":"震"},"lower":{"name":"山","symbol":"艮"},"judgment":"亨，利贞。可小事，不可大事。飞鸟遗之音。不宜上，宜下，大吉。","image":"山上有雷，小过。君子以行过乎恭，丧过乎衰，用过乎俭。","fortune":"吉","fortuneBasis":["亨","利贞","可小事，不可大事","大吉"],"lines":[{"position":1,"name":"初六","text":"飞鸟以凶。"},{"position":2,"name":"六二","text":"过其祖，遇其妣。不及其君，遇其臣，无咎。"},{"position":3,"name":"九三","text":"弗过防之，从或戕之，凶。"},{"position":4,"name":"九四","text":"无咎，弗过遇之，往厉必戒。勿用，永贞。"},{"position":5,"name":"六五","text":"密云不雨，自我西郊。公弋取彼在穴。"},{"position":6,"name":"上六","text":"弗遇过之，飞鸟离之，凶。是谓灾眚。"}]},{"id":63,"name":"既济","symbol":"䷾","pinyin":"jì jì","volume":"下经","upper":{"name":"水","symbol":"坎"},"lower":{"name":"火","symbol":"离"},"judgment":"亨小，利贞。初吉，终乱。","image":"水在火上，既济。君子以思患而豫防之。","fortune":"平","fortuneBasis":["亨小","利贞","初吉，终乱"],"lines":[{"position":1,"name":"初九","text":"曳其轮，濡其尾，无咎。"},{"position":2,"name":"六二","text":"妇丧其茀，勿逐，七日得。"},{"position":3,"name":"九三","text":"高宗伐鬼方，三年克之。小人勿用。"},{"position":4,"name":"六四","text":"𦈡有衣袽，终日戒。"},{"position":5,"name":"九五","text":"东邻杀牛，不如西郊之禴祭，实受其福。"},{"position":6,"name":"上六","text":"濡其首，厉。"}]},{"id":64,"name":"未济","symbol":"䷿","pinyin":"wèi jì","volume":"下经","upper":{"name":"火","symbol":"离"},"lower":{"name":"水","symbol":"坎"},"judgment":"亨。小狐汔济，濡其尾，无攸利。","image":"火在水上，未济。君子以慎辨物居方。","fortune":"平","fortuneBasis":["亨","小狐汔济","无攸利"],"lines":[{"position":1,"name":"初六","text":"濡其尾，吝。"},{"position":2,"name":"九二","text":"曳其轮，贞吉。"},{"position":3,"name":"六三","text":"未济，征凶，利涉大川。"},{"position":4,"name":"九四","text":"贞吉，悔亡，震用伐鬼方。三年有赏于大国。"},{"position":5,"name":"六五","text":"贞吉，无悔，君子之光。有孚，吉。"},{"position":6,"name":"上九","text":"有孚于饮酒，无咎。濡其首，有孚失是。"}]}]